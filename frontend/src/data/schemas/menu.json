{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Esquema de Cardápio URY",
  "description": "Esquema de formulário e dados para gerenciamento de Cardápio do Restaurante URY",
  "type": "object",
  "properties": {
    "menu_name": {
      "type": "string",
      "title": "Nome do Cardápio",
      "placeholder": "Ex.: Cardápio Principal",
      "minLength": 2
    },
    "branch": {
      "type": "string",
      "title": "Filial",
      "enum": ["Main Branch", "Downtown Branch", "Beachfront Outpost", "Express Outlet"],
      "default": "Main Branch"
    },
    "price_list": {
      "type": "string",
      "title": "Lista de Preços",
      "enum": ["Standard Rate", "Happy Hour Rate", "VIP Rate", "Delivery Rate"],
      "default": "Standard Rate"
    },
    "is_enabled": {
      "type": "boolean",
      "title": "Ativar Cardápio",
      "default": true
    },
    "tax_configuration": {
      "type": "object",
      "title": "Configuração de Impostos",
      "properties": {
        "tax_type": {
          "type": "string",
          "title": "Tipo de Imposto",
          "enum": ["Inclusive", "Exclusive"],
          "default": "Exclusive"
        },
        "tax_percentage": {
          "type": "number",
          "title": "Percentual de Imposto (%)",
          "default": 5.0,
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": ["tax_type", "tax_percentage"]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string", "title": "Nome do Item" },
          "course": {
            "type": "string",
            "title": "Categoria / Etapa",
            "enum": ["Appetizer", "Main Course", "Dessert", "Beverage", "Starter", "Side Dish"]
          },
          "price": { "type": "number", "title": "Preço", "minimum": 0 },
          "enabled": { "type": "boolean", "title": "Ativo", "default": true },
          "special_dish": { "type": "boolean", "title": "Prato Especial", "default": false },
          "image_url": { "type": "string", "title": "URL da Imagem" }
        },
        "required": ["name", "course", "price"]
      }
    }
  },
  "required": ["menu_name", "branch", "price_list"]
}
