{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Esquema de Perfil de PDV",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Nome do Perfil",
      "default": "Main POS Profile"
    },
    "branch": {
      "type": "string",
      "title": "Filial",
      "default": "Main Branch"
    },
    "restaurant": {
      "type": "string",
      "title": "Restaurante",
      "default": "URY Fine Dining"
    },
    "operations": {
      "type": "object",
      "properties": {
        "table_attention_time": {
          "type": "number",
          "title": "Tempo de Alerta de Mesa (min)",
          "default": 15
        },
        "paid_invoice_limit": {
          "type": "number",
          "title": "Limite de Faturas Pagas",
          "default": 50000
        },
        "enable_discounts": {
          "type": "boolean",
          "title": "Habilitar Descontos",
          "default": true
        },
        "show_item_images": {
          "type": "boolean",
          "title": "Exibir Imagens dos Itens",
          "default": true
        },
        "edit_order_type": {
          "type": "boolean",
          "title": "Permitir Editar Tipo de Pedido",
          "default": true
        },
        "remove_printed_items": {
          "type": "boolean",
          "title": "Permitir Remover Itens Impressos",
          "default": false
        },
        "view_all_status": {
          "type": "boolean",
          "title": "Visualizar Todos os Status",
          "default": true
        },
        "daily_pos_close_required": {
          "type": "boolean",
          "title": "Fechamento Diário de Caixa Obrigatório",
          "default": true
        }
      }
    },
    "printing": {
      "type": "object",
      "properties": {
        "enable_qz_printing": {
          "type": "boolean",
          "title": "Habilitar Impressão via QZ Tray",
          "default": true
        },
        "qz_host": {
          "type": "string",
          "title": "Host QZ",
          "default": "localhost"
        },
        "printers": {
          "type": "array",
          "title": "Configurações de Impressora",
          "items": {
            "type": "object",
            "properties": {
              "printer": { "type": "string", "title": "Nome da Impressora" },
              "bill_printing": { "type": "boolean", "title": "Impressão de Conta" },
              "kot_printing": { "type": "boolean", "title": "Impressão de Comanda (KOT)" }
            }
          }
        }
      }
    },
    "cashiers": {
      "type": "object",
      "properties": {
        "enable_multiple_cashiers": {
          "type": "boolean",
          "title": "Habilitar Múltiplos Operadores de Caixa",
          "default": true
        },
        "authorized_cashiers": {
          "type": "array",
          "title": "Operadores de Caixa Autorizados",
          "items": {
            "type": "object",
            "properties": {
              "user": { "type": "string", "title": "Usuário" },
              "main_cashier": { "type": "boolean", "title": "Caixa Principal" }
            }
          }
        }
      }
    },
    "kot": {
      "type": "object",
      "properties": {
        "naming_series": {
          "type": "string",
          "title": "Série de Numeração",
          "default": "KOT-.YYYY.-"
        },
        "warning_time": {
          "type": "number",
          "title": "Tempo de Aviso (min)",
          "default": 10
        },
        "enable_reprint": {
          "type": "boolean",
          "title": "Habilitar Reimpressão",
          "default": true
        },
        "alert_sound": {
          "type": "boolean",
          "title": "Som de Alerta",
          "default": true
        },
        "delay_notifications": {
          "type": "boolean",
          "title": "Notificações de Atraso",
          "default": false
        },
        "reset_order_number_daily": {
          "type": "boolean",
          "title": "Reiniciar Número do Pedido Diariamente",
          "default": true
        },
        "parcel_printer": {
          "type": "string",
          "title": "Impressora de Viagem / Embalagem",
          "default": "Thermal Printer 1"
        },
        "table_printer": {
          "type": "string",
          "title": "Impressora de Mesa",
          "default": "Kitchen Thermal Printer"
        },
        "reprint_format": {
          "type": "string",
          "title": "Formato de Reimpressão",
          "default": "Standard KOT"
        }
      }
    },
    "advanced": {
      "type": "object",
      "properties": {
        "allow_custom_rates": {
          "type": "boolean",
          "title": "Permitir Preços Personalizados",
          "default": false
        },
        "auto_select_table": {
          "type": "boolean",
          "title": "Selecionar Mesa Automaticamente",
          "default": true
        },
        "allow_negative_stock": {
          "type": "boolean",
          "title": "Permitir Estoque Negativo",
          "default": false
        },
        "default_customer": {
          "type": "string",
          "title": "Cliente Padrão",
          "default": "Walk-in Customer"
        },
        "tax_category": {
          "type": "string",
          "title": "Categoria de Imposto",
          "default": "Standard Tax"
        }
      }
    }
  }
}
