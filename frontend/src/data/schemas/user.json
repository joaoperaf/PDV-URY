{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Esquema de Usuário",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string",
      "title": "Nome"
    },
    "last_name": {
      "type": "string",
      "title": "Sobrenome"
    },
    "email": {
      "type": "string",
      "format": "email",
      "title": "E-mail"
    },
    "password": {
      "type": "string",
      "title": "Senha"
    },
    "roles": {
      "type": "array",
      "title": "Funções / Perfis",
      "items": {
        "type": "string",
        "enum": ["URY Cashier", "URY Waiter", "URY Manager"]
      }
    },
    "assigned_room": {
      "type": "string",
      "title": "Salão Atribuído"
    },
    "branch": {
      "type": "string",
      "title": "Filial"
    },
    "enabled": {
      "type": "boolean",
      "title": "Ativo",
      "default": true
    },
    "avatar": {
      "type": "string",
      "title": "URL do Avatar"
    }
  },
  "required": ["first_name", "email", "roles"]
}
