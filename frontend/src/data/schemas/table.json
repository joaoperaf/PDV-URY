{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Esquema de Mesa URY",
  "description": "Esquema de formulário e dados para gerenciamento de Mesas do Restaurante URY",
  "type": "object",
  "properties": {
    "table_name": {
      "type": "string",
      "title": "Nome / Número da Mesa",
      "placeholder": "Ex.: M-01",
      "minLength": 1
    },
    "seats": {
      "type": "integer",
      "title": "Quantidade de Lugares",
      "default": 4,
      "minimum": 1,
      "maximum": 30
    },
    "room": {
      "type": "string",
      "title": "Salão / Ambiente",
      "enum": ["Main Hall", "Terrace", "VIP Lounge", "Rooftop Garden", "Bar Counter"],
      "default": "Main Hall"
    },
    "branch": {
      "type": "string",
      "title": "Filial",
      "enum": ["Main Branch", "Downtown Branch", "Beachfront Outpost", "Express Outlet"],
      "default": "Main Branch"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": ["Available", "Occupied", "Reserved", "Cleaning"],
      "default": "Available"
    },
    "shape": {
      "type": "string",
      "title": "Formato da Mesa",
      "enum": ["Rectangle", "Square", "Circle"],
      "default": "Rectangle"
    },
    "layout": {
      "type": "object",
      "title": "Posição Avançada no Mapa",
      "properties": {
        "x": { "type": "integer", "title": "Posição X", "default": 0 },
        "y": { "type": "integer", "title": "Posição Y", "default": 0 },
        "width": { "type": "integer", "title": "Largura (px)", "default": 120 },
        "height": { "type": "integer", "title": "Altura (px)", "default": 80 }
      }
    }
  },
  "required": ["table_name", "seats", "room", "branch", "status", "shape"]
}
