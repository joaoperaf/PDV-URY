{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Esquema de Filial",
  "type": "object",
  "properties": {
    "branch_name": {
      "type": "string",
      "title": "Nome da Filial"
    },
    "invoice_series_prefix": {
      "type": "string",
      "title": "Prefixo da Série de Faturas",
      "default": "INV-MAIN-"
    },
    "aggregator_series_prefix": {
      "type": "string",
      "title": "Prefixo da Série de Agregadores",
      "default": "AGG-MAIN-"
    },
    "tax_id": {
      "type": "string",
      "title": "CNPJ / CPF"
    },
    "address": {
      "type": "string",
      "title": "Endereço"
    }
  },
  "required": ["branch_name", "invoice_series_prefix"]
}
