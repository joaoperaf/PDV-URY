{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Esquema de Salão / Ambiente URY",
  "description": "Esquema de formulário e dados para gerenciamento de Salões do Restaurante URY",
  "type": "object",
  "properties": {
    "room_name": {
      "type": "string",
      "title": "Nome do Salão / Ambiente",
      "placeholder": "Ex.: Salão VIP",
      "minLength": 2
    },
    "room_type": {
      "type": "string",
      "title": "Tipo de Ambiente",
      "enum": ["Indoor", "Outdoor", "Rooftop", "Private Dining", "Bar Area"],
      "default": "Indoor"
    },
    "branch": {
      "type": "string",
      "title": "Filial",
      "enum": ["Main Branch", "Downtown Branch", "Beachfront Outpost", "Express Outlet"],
      "default": "Main Branch"
    },
    "number_of_tables": {
      "type": "integer",
      "title": "Quantidade de Mesas",
      "default": 0,
      "minimum": 0
    },
    "printer_config": {
      "type": "object",
      "title": "Configuração de Impressora",
      "properties": {
        "kot_printing": {
          "type": "boolean",
          "title": "Habilitar Impressão de Comanda (KOT)",
          "default": true
        },
        "print_format": {
          "type": "string",
          "title": "Formato de Impressão",
          "enum": ["Standard KOT", "Detailed KOT", "Bar Ticket", "Kitchen Display"],
          "default": "Standard KOT"
        },
        "block_takeaway_printing": {
          "type": "boolean",
          "title": "Bloquear Impressão de Pedidos Para Viagem",
          "default": false
        }
      },
      "required": ["kot_printing", "print_format"]
    }
  },
  "required": ["room_name", "room_type", "branch"]
}
