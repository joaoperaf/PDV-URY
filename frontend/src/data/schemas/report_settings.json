{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Esquema de Configurações de Relatórios",
  "type": "object",
  "properties": {
    "business_hours": {
      "type": "object",
      "title": "Horário de Funcionamento",
      "properties": {
        "extended_hours": {
          "type": "boolean",
          "title": "Horário Estendido",
          "default": false
        },
        "hours_offset": {
          "type": "number",
          "title": "Compensação de Horas (horas)",
          "default": 4
        }
      }
    },
    "cost_configuration": {
      "type": "object",
      "title": "Configuração de Custos",
      "properties": {
        "buying_price_list": {
          "type": "string",
          "title": "Lista de Preços de Compra",
          "default": "Standard Buying"
        },
        "depreciation": {
          "type": "number",
          "title": "Taxa de Depreciação (%)",
          "default": 5.0
        },
        "electricity_charges": {
          "type": "number",
          "title": "Custos de Energia Elétrica (R$/mês)",
          "default": 1200.0
        }
      }
    },
    "expenses": {
      "type": "object",
      "title": "Despesas",
      "properties": {
        "direct_fixed_expenses": {
          "type": "array",
          "title": "Despesas Fixas Diretas",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "title": "Nome da Despesa" },
              "amount": { "type": "number", "title": "Valor" },
              "frequency": { "type": "string", "title": "Frequência" }
            }
          }
        },
        "indirect_fixed_expenses": {
          "type": "array",
          "title": "Despesas Fixas Indiretas",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "title": "Nome da Despesa" },
              "amount": { "type": "number", "title": "Valor" },
              "frequency": { "type": "string", "title": "Frequência" }
            }
          }
        },
        "percentage_expenses": {
          "type": "array",
          "title": "Despesas Percentuais",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "title": "Nome da Despesa" },
              "percentage": { "type": "number", "title": "Percentual (%)" },
              "basis": { "type": "string", "title": "Base de Cálculo" }
            }
          }
        },
        "employee_costs": {
          "type": "array",
          "title": "Custos com Equipe",
          "items": {
            "type": "object",
            "properties": {
              "role": { "type": "string", "title": "Cargo / Função" },
              "salary": { "type": "number", "title": "Salário Mensal" },
              "count": { "type": "number", "title": "Quantidade de Funcionários" }
            }
          }
        },
        "monthly_fixed_expenses": {
          "type": "array",
          "title": "Despesas Fixas Mensais",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string", "title": "Nome da Despesa" },
              "amount": { "type": "number", "title": "Valor Mensal" }
            }
          }
        },
        "consumables": {
          "type": "array",
          "title": "Insumos / Descartáveis",
          "items": {
            "type": "object",
            "properties": {
              "item_name": { "type": "string", "title": "Nome do Item" },
              "monthly_budget": { "type": "number", "title": "Orçamento Mensal" }
            }
          }
        }
      }
    }
  }
}
